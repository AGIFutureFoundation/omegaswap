{
  "name": "GiftCard",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "description": "Gift card brand"
    },
    "balance": {
      "type": "number",
      "description": "Remaining face balance in USD"
    },
    "last4": {
      "type": "string",
      "description": "Last 4 characters of the card code, for reference only"
    }
  },
  "required": [
    "brand",
    "balance"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}