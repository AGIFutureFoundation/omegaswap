{
  "name": "LedgerEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the cash balance"
    },
    "amount": {
      "type": "number",
      "description": "Signed USD amount: positive = credit, negative = debit"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "purchase"
      ]
    },
    "memo": {
      "type": "string"
    },
    "ref": {
      "type": "string",
      "description": "Unique reference (deposit or listing id) to prevent double posting"
    }
  },
  "required": [
    "user_id",
    "amount",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}