{
  "name": "AgentPayment",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "description": "Agent that earned the micro payment"
    },
    "protocol": {
      "type": "string",
      "description": "Payment protocol label, e.g. x402"
    },
    "amount": {
      "type": "number",
      "description": "USD amount"
    },
    "memo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "settled",
        "failed"
      ],
      "default": "recorded",
      "description": "recorded = ledger only, settled = USDC sent on-chain"
    },
    "tx_signature": {
      "type": "string",
      "description": "Transaction signature when settled"
    },
    "source_agent": {
      "type": "string",
      "description": "Agent that sourced the deal (Scout, Broker or Vendor)"
    },
    "profit": {
      "type": "number",
      "description": "USD profit captured on the trade"
    },
    "spread_pct": {
      "type": "number",
      "description": "Profit as a percent of the purchase price"
    },
    "chain": {
      "type": "string",
      "description": "Chain the agent's wallet is on"
    },
    "payout_address": {
      "type": "string",
      "description": "Wallet address the payment is routed to"
    }
  },
  "required": [
    "agent",
    "amount"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}