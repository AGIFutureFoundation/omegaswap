{
  "name": "AgentPayment",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "description": "Agent that earned the micro payment"
    },
    "protocol": {
      "type": "string",
      "description": "Payment protocol label, e.g. x402"
    },
    "amount": {
      "type": "number",
      "description": "USD amount"
    },
    "memo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "settled",
        "failed"
      ],
      "default": "recorded",
      "description": "recorded = ledger only, settled = USDC sent on Solana"
    },
    "tx_signature": {
      "type": "string",
      "description": "Solana transaction signature when settled"
    }
  },
  "required": [
    "agent",
    "amount"
  ]
}