{
  "name": "AgentWallet",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "description": "Agent name this wallet belongs to, e.g. Arbiter or Hermes Scout"
    },
    "chain": {
      "type": "string",
      "enum": [
        "solana",
        "base",
        "polygon",
        "arbitrum",
        "ethereum",
        "optimism",
        "avalanche",
        "bnb"
      ],
      "default": "solana"
    },
    "address": {
      "type": "string",
      "description": "Payout address on that chain"
    }
  },
  "required": [
    "agent",
    "chain",
    "address"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}